# Public site URL (used for link previews and the sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Privy: dashboard.privy.io → your app → Settings
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Supabase: Project settings → API keys (service role or secret key; server only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Deployed CampaignFactory addresses and start blocks (packages/contracts/deployments/<chain id>.json)
NEXT_PUBLIC_FACTORY_CELO_SEPOLIA=
NEXT_PUBLIC_FROM_BLOCK_CELO_SEPOLIA=
NEXT_PUBLIC_FACTORY_BASE_SEPOLIA=
NEXT_PUBLIC_FROM_BLOCK_BASE_SEPOLIA=
# Test Kenyan shilling deployed with DEPLOY_TEST_KES=true ("testKes" in deployments/11142220.json)
NEXT_PUBLIC_TEST_KES_CELO_SEPOLIA=

# RPC endpoints used by the server (may include a provider API key; never exposed to the browser)
RPC_CELO_SEPOLIA=
RPC_BASE_SEPOLIA=

# Gas tank: a test-only wallet that pays new users' transaction costs
GAS_TANK_PRIVATE_KEY=
GAS_TANK_ADDRESS=
GAS_TOPUP_CELO=0.05
GAS_TOPUP_ETH=0.00005
# Starter test funds per new user (empty turns them off). KES is minted from the test token; USDC comes from the tank.
STARTER_KES=1000
STARTER_USDC=2

# Protects /api/sync (scheduled catch-up of on-chain contributions)
CRON_SECRET=

# Optional contact address shown on the contact page
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional local development chain (pnpm --filter @fadhili/contracts node, then deploy:local)
# NEXT_PUBLIC_FACTORY_LOCAL=0x5FbDB2315678afecb367f032d93F642f64180aa3
